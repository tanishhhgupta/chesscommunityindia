{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/chessmanager/(.*)",
      "destination": "/chessmanager/$1"
    },
    {
      "source": "/chessmanager",
      "destination": "/chessmanager/index.html"
    },
    {
      "source": "/((?!assets/|fonts/|images/|logos/|partners/|videos/|frames/|frames2/|uploads/|favicon|robots|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}
